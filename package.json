{
  "name": "pat-and-cha-wedding-site",
  "version": "1.0.0",
  "description": "A wedding website for Pat and Cha built using an HTML5 UP template.",
  "main": "index.html",
  "scripts": {
    "dev": "npm-run-all --parallel watch:sass serve",
    "watch:sass": "sass --watch assets/sass:assets/css --style expanded",
    "build:sass": "sass assets/sass:assets/css --style compressed",
    "serve": "live-server --port=3000 --open=/index.html --watch=assets/css,index.html,assets/js",
    "start": "npm run dev"
  },
  "devDependencies": {
    "sass": "^1.69.5",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5"
  },
  "keywords": [
    "html5up",
    "template",
    "wedding",
    "responsive",
    "web"
  ],
  "author": "Patrick Bagacina",
  "license": "CCA 3.0"
}